---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPapers = await getCollection('papers');

const burrowing = allPapers.filter(p => p.data.tags?.includes('burrowing') || p.data.tags?.includes('granular media'));
const beyond = allPapers.filter(p => p.data.tags?.includes('metamaterials'));
const nasa = allPapers.filter(p => false); // NASA-specific papers added here in future

const sortPapers = (papers: typeof allPapers) =>
  papers.sort((a, b) => {
    const order: Record<string, number> = { J: 0, C: 1 };
    const aType = a.data.id[0];
    const bType = b.data.id[0];
    if (aType !== bType) return (order[aType] ?? 9) - (order[bType] ?? 9);
    return parseInt(b.data.id.slice(1)) - parseInt(a.data.id.slice(1));
  });

const allSorted = sortPapers([...allPapers]);
---

<Base
  title="Research"
  description="Soft robotics research on burrowing locomotion, granular media, and planetary exploration."
>

<div id="search" class="page-wrap" style="padding-top:2rem">
  <div id="pagefind-search"></div>
</div>

<!-- ── Burrowing Robots ───────────────────────────── -->
<section class="section-pad">
  <div class="page-wrap">
    <p class="eyebrow" style="margin-bottom:0.5rem">Primary Research</p>
    <h2 style="margin-bottom:0.5rem">Burrowing Soft Robots</h2>
    <p style="max-width:56ch;margin-bottom:2.5rem;color:var(--ink-mid)">
      I study how soft robots move through granular materials like sand, soil, and lunar regolith. Most of my work focuses on understanding the forces involved in burrowing and using that to build robots that actually work underground.
    </p>

    <div style="display:flex;flex-direction:column;gap:1.5rem;margin-bottom:3rem">
      {sortPapers([...burrowing]).map(paper => (
        <article class="paper-card" data-pagefind-body>
          <div class="paper-visual">
            {paper.data.video ? (
              <video autoplay muted loop playsinline>
                <source src={paper.data.video} type="video/mp4" />
              </video>
            ) : paper.data.thumbnail ? (
              <img src={paper.data.thumbnail} alt={paper.data.title} loading="lazy" />
            ) : (
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:2rem">🤖</div>
            )}
          </div>
          <div class="paper-body">
            <div class="paper-meta">
              <span class="paper-venue">{paper.data.venue} · {paper.data.year}</span>
            </div>
            <h3 class="paper-title">{paper.data.title}</h3>
            <p class="paper-abstract">{paper.data.abstract}</p>
            <a href={paper.data.url} target="_blank" rel="noopener" class="btn btn-navy" style="width:fit-content;margin-top:auto">
              Read paper →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Publications list -->
    <h3 style="font-size:0.75rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem">Full Publication List</h3>
    <div class="pub-list">
      {allSorted.map(paper => (
        <div class="pub-item">
          <div class="pub-item-text">
            <strong>{paper.data.title}</strong>
            {' '}— <a href={paper.data.url} target="_blank" rel="noopener">{paper.data.venue}</a>, {paper.data.year}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── Beyond Burrowing ───────────────────────────── -->
{beyond.length > 0 && (
  <section class="section-pad stripe-rust">
    <div class="page-wrap">
      <p class="eyebrow" style="margin-bottom:0.5rem">Beyond Burrowing</p>
      <h2 style="margin-bottom:0.5rem">Related Research</h2>
      <p style="max-width:56ch;margin-bottom:2.5rem;color:var(--ink-mid)">
        Adjacent work in granular metamaterials and reconfigurable structures.
      </p>
      <div style="display:flex;flex-direction:column;gap:1.5rem">
        {sortPapers([...beyond]).map(paper => (
          <article class="paper-card" data-pagefind-body>
            <div class="paper-visual">
              {paper.data.video ? (
                <video autoplay muted loop playsinline>
                  <source src={paper.data.video} type="video/mp4" />
                </video>
              ) : paper.data.thumbnail ? (
                <img src={paper.data.thumbnail} alt={paper.data.title} loading="lazy" />
              ) : null}
            </div>
            <div class="paper-body">
              <div class="paper-meta">
                <span class="paper-venue">{paper.data.venue} · {paper.data.year}</span>
              </div>
              <h3 class="paper-title">{paper.data.title}</h3>
              <p class="paper-abstract">{paper.data.abstract}</p>
              <a href={paper.data.url} target="_blank" rel="noopener" class="btn btn-navy" style="width:fit-content;margin-top:auto">
                Read paper →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ── NASA ───────────────────────────────────────── -->
<section class="section-pad stripe-navy">
  <div class="page-wrap">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start">
      <div>
        <p class="eyebrow" style="margin-bottom:0.75rem">NASA Collaboration</p>
        <h2 style="margin-bottom:0.75rem">Glenn Research Center</h2>
        <p style="color:color-mix(in srgb,var(--white) 80%,transparent);margin-bottom:1.25rem">
          As a NASA NSTGRO Fellow, I've completed two residencies at NASA Glenn Research Center, working on regolith mechanics and burrowing locomotion for planetary exploration.
        </p>
        <div class="award-badge" style="margin-bottom:1.5rem">
          <span>🏆</span> NASA NSTGRO Fellow
        </div>
        <div style="display:flex;flex-direction:column;gap:0.75rem">
          <div style="background:color-mix(in srgb,var(--white) 10%,transparent);border:1px solid color-mix(in srgb,var(--white) 20%,transparent);border-radius:var(--radius);padding:1rem 1.25rem">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:color-mix(in srgb,var(--white) 55%,transparent);margin-bottom:0.35rem">Summer 2024</div>
            <div style="font-weight:700;color:var(--white);font-size:0.9rem">Glenn Research Center Residency #1</div>
            <div style="font-size:0.78rem;color:color-mix(in srgb,var(--white) 65%,transparent);margin-top:0.2rem">Used the TREC rig to test the effects of intruder moduli on intrusion forces</div>
          </div>
          <div style="background:color-mix(in srgb,var(--white) 10%,transparent);border:1px solid color-mix(in srgb,var(--white) 20%,transparent);border-radius:var(--radius);padding:1rem 1.25rem">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:color-mix(in srgb,var(--white) 55%,transparent);margin-bottom:0.35rem">Summer 2025</div>
            <div style="font-weight:700;color:var(--white);font-size:0.9rem">Glenn Research Center Residency #2</div>
            <div style="font-size:0.78rem;color:color-mix(in srgb,var(--white) 65%,transparent);margin-top:0.2rem">Characterized the Excavation rig and tested intruder moduli effects on intrusion forces</div>
          </div>
        </div>
      </div>
      <div>
        <div class="photo-grid">
          <img src="/assets/VTE glenn respirator.jpg" alt="Caitlin at NASA Glenn" loading="lazy" />
          <img src="/assets/VTE glenn excavation sample.jpg" alt="Excavation sample at Glenn" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  window.addEventListener('DOMContentLoaded', async () => {
    try {
      const { PagefindUI } = await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
      new PagefindUI({ element: '#pagefind-search', showSubResults: true });
    } catch {
      // pagefind not built yet; hide the search container
      const el = document.getElementById('pagefind-search');
      if (el) el.style.display = 'none';
    }
  });
</script>

</Base>
