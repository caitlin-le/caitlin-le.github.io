---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../../assets/headshot.jpg';

const papers = (await getCollection('papers')).sort((a, b) => {
  const order = { J: 0, C: 1 };
  const aType = a.data.id[0] as 'J' | 'C';
  const bType = b.data.id[0] as 'J' | 'C';
  if (aType !== bType) return order[aType] - order[bType];
  return parseInt(b.data.id.slice(1)) - parseInt(a.data.id.slice(1));
});

const featured = papers.filter(p => p.data.video || p.data.thumbnail).slice(0, 2);
---

<Base
  title="Caitlin Le"
  description="PhD candidate at Princeton's Faboratory. I design soft robots that burrow through granular media."
>

<!-- ── Hero ──────────────────────────────────────── -->
<section class="section-pad">
  <div class="page-wrap">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="eyebrow" style="margin-bottom:0.75rem">Princeton University · Robotics</p>
        <h1>Caitlin Le</h1>
        <p class="hero-sub">
          PhD candidate in the <a href="https://faboratory.princeton.edu" target="_blank" rel="noopener" style="color:var(--navy);font-weight:700;">Faboratory</a> at Princeton.
          I design soft robots that burrow through granular media — sand, gravel, soil — to understand and engineer locomotion underground.
        </p>
        <p class="hero-sub" style="margin-top:0.5rem;font-size:0.82rem;color:var(--muted)">
          Outside the lab: I run a one-person ice cream kitchen.
          <a href="/icecream" style="color:var(--navy);font-weight:700;">See 13 recipes →</a>
        </p>
        <div class="hero-btns">
          <a href="/research" class="btn btn-navy">View research</a>
          <a href="/cv.pdf" class="btn btn-outline" target="_blank">Download CV</a>
        </div>
      </div>
      <div class="hero-photo">
        <Image
          src={headshot}
          alt="Caitlin Le"
          width={420}
          height={560}
          class="headshot-img"
        />
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-row" style="margin-top:2rem">
      <div class="stat-card">
        <div class="stat-num">{papers.length}</div>
        <div class="stat-label">Publications</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">NSTGRO</div>
        <div class="stat-label">NASA Space Technology Graduate Research Fellow</div>
      </div>
      <div class="stat-card">
        <div class="stat-num">2×</div>
        <div class="stat-label">NASA Glenn Research Center Residency</div>
      </div>
    </div>
  </div>
</section>

<!-- ── Research ───────────────────────────────────── -->
<section class="section-pad" style="background:var(--surface)">
  <div class="page-wrap">
    <p class="eyebrow" style="margin-bottom:0.5rem">Research</p>
    <h2 style="margin-bottom:0.5rem">Burrowing Soft Robotics</h2>
    <p style="max-width:52ch;margin-bottom:2rem">
      My work sits at the intersection of soft robotics, granular physics, and materials science. I build robots that navigate underground environments by leveraging the mechanics of granular media.
    </p>

    <div style="display:flex;flex-direction:column;gap:1.25rem;margin-bottom:2.5rem">
      {featured.map(paper => (
        <article class="paper-card">
          <div class="paper-visual">
            {paper.data.video ? (
              <video autoplay muted loop playsinline>
                <source src={paper.data.video} type="video/mp4" />
              </video>
            ) : paper.data.thumbnail ? (
              <img src={paper.data.thumbnail} alt={paper.data.title} loading="lazy" />
            ) : null}
          </div>
          <div class="paper-body">
            <div class="paper-meta">
              <span class="paper-id">{paper.data.id}</span>
              <span class="paper-venue">{paper.data.venue} · {paper.data.year}</span>
            </div>
            <h3 class="paper-title">{paper.data.title}</h3>
            {paper.data.abstract && <p class="paper-abstract">{paper.data.abstract}</p>}
            <a href={paper.data.url} target="_blank" rel="noopener" class="btn btn-navy" style="width:fit-content;margin-top:auto">
              Read paper →
            </a>
          </div>
        </article>
      ))}
    </div>

    <h3 style="font-size:0.8rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem">All Publications</h3>
    <div class="pub-list">
      {papers.map(paper => (
        <div class="pub-item">
          <span class="pub-item-id">{paper.data.id}</span>
          <div class="pub-item-text">
            <strong>{paper.data.title}</strong>
            {' '}— <a href={paper.data.url} target="_blank" rel="noopener">{paper.data.venue}</a>, {paper.data.year}
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:1.5rem">
      <a href="/research" class="btn btn-outline">All research →</a>
    </div>
  </div>
</section>

<!-- ── NASA ───────────────────────────────────────── -->
<section class="section-pad stripe-navy">
  <div class="page-wrap">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start">
      <div>
        <p class="eyebrow" style="margin-bottom:0.75rem">NASA NSTGRO Fellowship</p>
        <h2 style="margin-bottom:0.75rem">Supported by NASA Space Technology</h2>
        <p style="margin-bottom:1.25rem;color:color-mix(in srgb,var(--white) 80%,transparent)">
          Recipient of the NASA Space Technology Graduate Research Opportunities (NSTGRO) fellowship,
          supporting research into planetary subsurface exploration through soft robotics.
        </p>
        <div class="award-badge" style="margin-bottom:1.5rem">
          <span>🏆</span> NASA NSTGRO Fellow
        </div>
        <div style="display:flex;flex-direction:column;gap:0.75rem">
          <div style="background:color-mix(in srgb,var(--white) 10%,transparent);border:1px solid color-mix(in srgb,var(--white) 20%,transparent);border-radius:var(--radius);padding:1rem 1.25rem">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:color-mix(in srgb,var(--white) 55%,transparent);margin-bottom:0.35rem">Summer 2024</div>
            <div style="font-weight:700;color:var(--white);font-size:0.9rem">Glenn Research Center Residency #1</div>
            <div style="font-size:0.78rem;color:color-mix(in srgb,var(--white) 65%,transparent);margin-top:0.2rem">In situ resource utilization · Regolith mechanics</div>
          </div>
          <div style="background:color-mix(in srgb,var(--white) 10%,transparent);border:1px solid color-mix(in srgb,var(--white) 20%,transparent);border-radius:var(--radius);padding:1rem 1.25rem">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:color-mix(in srgb,var(--white) 55%,transparent);margin-bottom:0.35rem">Summer 2025</div>
            <div style="font-weight:700;color:var(--white);font-size:0.9rem">Glenn Research Center Residency #2</div>
            <div style="font-size:0.78rem;color:color-mix(in srgb,var(--white) 65%,transparent);margin-top:0.2rem">Burrowing locomotion · Planetary simulants</div>
          </div>
        </div>
      </div>
      <div>
        <div class="photo-grid">
          <img src="/assets/VTE glenn respirator.jpg" alt="Caitlin Le at NASA Glenn Research Center" loading="lazy" />
          <img src="/assets/VTE glenn excavation sample.jpg" alt="Excavation sample at NASA Glenn" loading="lazy" style="transform: rotate(90deg); transform-origin: center; object-position: center;" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── About / CV ─────────────────────────────────── -->
<section class="section-pad stripe-navy" style="padding-top:0;background:var(--navy)">
  <div class="page-wrap" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem">
    <div>
      <p class="eyebrow" style="margin-bottom:0.75rem;color:color-mix(in srgb,var(--white) 55%,transparent)">About</p>
      <h2 style="margin-bottom:0.75rem">Background</h2>
      <p style="color:color-mix(in srgb,var(--white) 75%,transparent);margin-bottom:1.5rem">
        I'm a roboticist, cook, and occasional trail runner. Before Princeton I studied mechanical engineering, and I've spent time in Vietnam doing fieldwork on construction sites — which turns out to share a lot of physics with granular robotics.
      </p>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap">
        <a href="/about" class="btn" style="background:color-mix(in srgb,var(--white) 15%,transparent);color:var(--white);border:1px solid color-mix(in srgb,var(--white) 30%,transparent)">More about me</a>
        <a href="/cv.pdf" class="btn" style="background:color-mix(in srgb,var(--white) 15%,transparent);color:var(--white);border:1px solid color-mix(in srgb,var(--white) 30%,transparent)" target="_blank">Download CV</a>
      </div>
    </div>
    <div>
      <p class="eyebrow" style="margin-bottom:1rem;color:color-mix(in srgb,var(--white) 55%,transparent)">Highlights</p>
      <div>
        <div class="cv-row">
          <span class="cv-year">2022–</span>
          <span class="cv-text">PhD Candidate, Mechanical & Aerospace Engineering, Princeton University</span>
        </div>
        <div class="cv-row">
          <span class="cv-year">2024</span>
          <span class="cv-text">NASA NSTGRO Fellow</span>
        </div>
        <div class="cv-row">
          <span class="cv-year">2024–25</span>
          <span class="cv-text">NASA Glenn Research Center Residency (×2)</span>
        </div>
        <div class="cv-row">
          <span class="cv-year">2022</span>
          <span class="cv-text">BS Mechanical Engineering, [Undergraduate Institution]</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Contact ────────────────────────────────────── -->
<section class="section-pad">
  <div class="page-wrap">
    <p class="eyebrow" style="margin-bottom:0.5rem;text-align:center">Get in touch</p>
    <h2 style="text-align:center;margin-bottom:2rem">Contact</h2>
    <div class="contact-grid">
      <a href="mailto:cl6244@princeton.edu" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <span class="contact-label">Email</span>
        <span class="contact-sub">cl6244@princeton.edu</span>
      </a>
      <a href="https://scholar.google.com" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <span class="contact-label">Google Scholar</span>
        <span class="contact-sub">View publications</span>
      </a>
      <a href="https://linkedin.com/in/caitlin-le" target="_blank" rel="noopener" class="contact-card">
        <div class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <span class="contact-label">LinkedIn</span>
        <span class="contact-sub">Connect professionally</span>
      </a>
    </div>
  </div>
</section>

</Base>

<style>
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 3rem;
  align-items: start;
}
.hero-text { padding-top: 1rem; }
.hero-sub {
  font-size: 1rem;
  color: var(--ink-mid);
  max-width: 48ch;
  margin-top: 1rem;
  line-height: 1.65;
}
.hero-btns {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.75rem;
  flex-wrap: wrap;
}
.headshot-img {
  width: 100%;
  height: auto;
  border-radius: var(--radius-lg);
  object-fit: cover;
  aspect-ratio: 3/4;
}

@media (max-width: 800px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }
  .hero-photo {
    max-width: 280px;
    order: -1;
  }
}
</style>
